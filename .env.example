# ==============================================================================
# PITC Bill Checker - Environment Configuration (Template)
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Proxy Configuration
# Paste your proxy URL below to route PITC bill fetching through your proxy.
# (Recommended if deploying outside Pakistan or if PITC is blocking your IP)
#
# Supported formats:
#   http://username:password@ip:port
#   http://ip:port
#   socks5://username:password@ip:port
PROXY_URL=http://username:password@proxy-host:port

